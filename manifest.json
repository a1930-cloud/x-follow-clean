{
  "manifest_version": 3,
  "name": "留关 · X 名单整理",
  "version": "0.3.9",
  "description": "自动滚动收集 X 名单、本地比对、保留账号，并按确认的名单逐个取关。",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "留关 · 收集当前列表"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'"
  },
  "optional_host_permissions": [
    "https://x.com/*"
  ]
}
